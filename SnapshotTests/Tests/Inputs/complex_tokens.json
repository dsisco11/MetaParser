{
  "$schema": "https://raw.githubusercontent.com/dsisco11/MetaParser/master/Schemas/schema-02.json",
  "namespace": "Foo.Bar.Tokens",
  "definitions": {
    "keyword_var": {
      "$type": "constant",
      "start": "var"
    },
    "keyword_function": {
      "$type": "constant",
      "start": "function"
    },
    "char_open_bracket": {
      "$type": "constant",
      "start": "{"
    },
    "char_close_bracket": {
      "$type": "constant",
      "start": "}"
    },
    "char_asterisk": {
      "$type": "constant",
      "start": "*"
    },
    "char_solidus": {
      "$type": "constant",
      "start": "/"
    },
    "char_reverse_solidus": {
      "$type": "constant",
      "start": "\\"
    },
    "whitespace": {
      "$type": "constant",
      "consume": [ " ", "\t", "\f" ]
    },
    "digits": {
      "$type": "constant",
      "consume": { "range": [ "0", "9" ] }
    },
    "letters": {
      "$type": "constant",
      "consume": [
        { "range": [ "a", "z" ] },
        { "range": [ "A", "Z" ] }
      ]
    },
    "newline": {
      "$type": "constant",
      "consume": "\n"
    },
    "identifier": {
      "$type": "compound",
      "start": [ "letters" ],
      "consume": [ "letters", "digits" ]
    },
    "comment": {
      "$type": "compound",
      "start": [ "char_solidus", "char_asterisk" ],
      "stop": [ "char_asterisk", "char_solidus" ]
    }
  }
}