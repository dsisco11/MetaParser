{
  "$schema": "https://raw.githubusercontent.com/dsisco11/MetaParser/master/Schemas/schema-02.json",
  "namespace": "UnitTestParser",
  "stages": [
    {
      "$type": "lexer",
      "consumers": {
        "whitespace": {
          "consume": [ " ", "\t", "\f" ]
        },
        "newline": {
          "consume": [ "\r", "\n" ]
        },
        "keyword_var": {
          "start": "var"
        },
        "keyword_vars": {
          "start": "vars"
        },
        "keyword_function": {
          "start": "function"
        },
        "keyword_byte": {
          "start": "byte"
        },
        "keyword_short": {
          "start": "short"
        },
        "keyword_int": {
          "start": "int"
        },
        "keyword_uint": {
          "start": "uint"
        },
        "keyword_float": {
          "start": "float"
        },
        "char_open_bracket": {
          "start": "{"
        },
        "char_close_bracket": {
          "start": "}"
        },
        "char_open_sqbracket": {
          "start": "["
        },
        "char_close_sqbracket": {
          "start": "]"
        },
        "char_open_parenthesis": {
          "start": "("
        },
        "char_close_parenthesis": {
          "start": ")"
        },
        "char_colon": {
          "start": ":"
        },
        "char_semicolon": {
          "start": ";"
        },
        "char_asterisk": {
          "start": "*"
        },
        "char_solidus": {
          "start": "/"
        },
        "char_reverse_solidus": {
          "start": "\\"
        },
        "digits": {
          "consume": { "range": [ "0", "9" ] }
        },
        "identifier": [
          {
            "start": [
              {
                "oneof": [
                  { "range": [ "a", "z" ] },
                  { "range": [ "A", "Z" ] }
                ]
              }
            ],
            "consume": [
              { "range": [ "a", "z" ] },
              { "range": [ "A", "Z" ] },
              { "range": [ "0", "9" ] },
              "-",
              "_"
            ]
          }
        ],
        "comment": [
          {
            "start": [ "/*" ],
            "stop": [ "*/" ],
            "escape": [ "\\" ]
          },
          {
            "start": [ "//" ],
            "stop": [ "\n" ],
            "escape": [ "\\" ]
          }
        ]
      }
    },
    {
      "$type": "syntax",
      "consumers": {
        "typename": [
          {
            "start": "keyword_var"
          },
          {
            "start": "keyword_vars"
          },
          {
            "start": "keyword_byte"
          },
          {
            "start": "keyword_short"
          },
          {
            "start": "keyword_int"
          },
          {
            "start": "keyword_uint"
          },
          {
            "start": "keyword_float"
          }
        ],
        "comment": [
          {
            "start": [
              "char_solidus",
              "char_solidus"
            ],
            "stop": [ "newline" ]
          },
          {
            "start": [ "char_solidus", "char_asterisk" ],
            "stop": [ "char_asterisk", "char_solidus" ],
            "escape": [ "char_reverse_solidus" ]
          }
        ],
        "declaration": {
          "start": [ "identifier", "char_colon" ],
          "stop": [ "char_semicolon" ]
        },
        "codeblock": {
          "start": [ "char_open_bracket" ],
          "consume": [ "declaration" ],
          "stop": [ "char_close_bracket" ]
        },
        "program": {
          "start": [
            { "oneof": [ "keyword_var", "keyword_function" ] }
          ],
          "consume": [
            "whitespace",
            "identifier",
            "whitespace",
            "char_open_parenthesis",
            "whitespace",
            "char_close_parenthesis",
            "whitespace",
            "char_open_bracket",
            "whitespace",
            "char_close_bracket"
          ]
        }
      }
    }
  ]
}