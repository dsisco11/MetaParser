{
  "$schema": "https://raw.githubusercontent.com/dsisco11/MetaParser/master/Schemas/schema-02.json",
  "namespace": "UnitTestParser",
  "definitions": {
    "solidus": {
      "$type": "data",
      "start": "/"
    },
    "colon": {
      "$type": "data",
      "start": ":"
    },
    "semicolon": {
      "$type": "data",
      "start": ";"
    },
    "open_bracket": {
      "$type": "data",
      "start": "{"
    },
    "close_bracket": {
      "$type": "data",
      "start": "}"
    },
    "open_sqbracket": {
      "$type": "data",
      "start": "["
    },
    "close_sqbracket": {
      "$type": "data",
      "start": "]"
    },
    "open_parenthesis": {
      "$type": "data",
      "start": "("
    },
    "close_parenthesis": {
      "$type": "data",
      "start": ")"
    },
    "whitespace": {
      "$type": "data",
      "consume": [ " ", "\t", "\f" ]
    },
    "newline": {
      "$type": "data",
      "consume": [ "\r", "\n" ]
    },
    "identifier": [
      {
        "$type": "data",
        "start": [
          {
            "oneof": [
              { "range": [ "a", "z" ] },
              { "range": [ "A", "Z" ] }
            ]
          }
        ],
        "consume": [
          { "range": [ "a", "z" ] },
          { "range": [ "A", "Z" ] },
          { "range": [ "0", "9" ] },
          "-",
          "_"
        ]
      }
    ],
    "comment": [
      {
        "$type": "data",
        "start": [ "/*" ],
        "stop": [ "*/" ],
        "escape": [ "\\" ]
      },
      {
        "$type": "tokens",
        "start": [
          { "id": "solidus" },
          { "id": "solidus" }
        ],
        "stop": [ { "id": "newline" } ]
      }
    ],
    "declaration": {
      "$type": "tokens",
      "start": [ "identifier", "colon" ],
      "stop": [ "semicolon" ]
    },
    "codeblock": {
      "$type": "tokens",
      "start": [ "open_bracket" ],
      "consume": [ "declaration" ],
      "stop": [ "close_bracket" ]
    }
  }
}