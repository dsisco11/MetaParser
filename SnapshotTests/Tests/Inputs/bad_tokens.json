{
  "$schema": "https://raw.githubusercontent.com/dsisco11/MetaParser/master/Schemas/schema-01.json",
  "namespace": "Foo.Bar.Tokens",
  "definitions": {
    "keyword_var": {
      "$type": "constant",
      "value": "var"
    },
    "keyword_var2": {
      "$type": "constant",
      "value": "var"
    },
    "whitespace": {
      "$type": "compound",
      "consume": [ " ", "\t", "\f", "\r", "\n" ]
    },
    "newline": {
      "$type": "compound",
      "consume": [ "\r", "\n" ]
    },
    "digits": {
      "$type": "compound",
      "consume": { "range": [ "0", "9" ] }
    },
    "letters": {
      "$type": "compound",
      "consume": [
        { "range": [ "a", "z" ] },
        { "range": [ "A", "Z" ] }
      ]
    },
    "identifier": {
      "$type": "complex",
      "start": [ "letters" ],
      "consume": [ "letters", "digits" ]
    },
    "comment": {
      "$type": "complex",
      "start": [ "char_solidus", "char_asterisk" ],
      "stop": [ "char_asterisk", "char_solidus" ]
    }
  }
}