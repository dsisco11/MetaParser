{
  "$schema": "https://raw.githubusercontent.com/dsisco11/MetaParser/master/Schemas/schema-01.json",
  "namespace": "UnitTestParser",
  "definitions": {
    "keyword_var": {
      "$type": "constant",
      "start": "var"
    },
    "keyword_function": {
      "$type": "constant",
      "start": "function"
    },
    "keyword_byte": {
      "$type": "constant",
      "start": "byte"
    },
    "keyword_short": {
      "$type": "constant",
      "start": "short"
    },
    "keyword_int": {
      "$type": "constant",
      "start": "int"
    },
    "keyword_float": {
      "$type": "constant",
      "start": "float"
    },
    "char_open_bracket": {
      "$type": "constant",
      "start": "{"
    },
    "char_close_bracket": {
      "$type": "constant",
      "start": "}"
    },
    "char_open_sqbracket": {
      "$type": "constant",
      "start": "["
    },
    "char_close_sqbracket": {
      "$type": "constant",
      "start": "]"
    },
    "char_open_parenthesis": {
      "$type": "constant",
      "start": "("
    },
    "char_close_parenthesis": {
      "$type": "constant",
      "start": ")"
    },
    "char_asterisk": {
      "$type": "constant",
      "start": "*"
    },
    "char_solidus": {
      "$type": "constant",
      "start": "/"
    },
    "char_reverse_solidus": {
      "$type": "constant",
      "start": "\\"
    },
    "whitespace": {
      "$type": "constant",
      "consume": [ " ", "\t", "\f" ]
    },
    "digits": {
      "$type": "constant",
      "consume": { "range": [ "0", "9" ] }
    },
    "letters": {
      "$type": "constant",
      "consume": [
        { "range": [ "a", "z" ] },
        { "range": [ "A", "Z" ] }
      ]
    },
    "newline": {
      "$type": "constant",
      "consume": "\n"
    },
    "identifier": {
      "$type": "compound",
      "start": [ "letters" ],
      "consume": [ "letters", "digits" ]
    },
    "comment": {
      "$type": "compound",
      "start": [ "char_solidus", "char_asterisk" ],
      "stop": [ "char_asterisk", "char_solidus" ],
      "escape": [ "char_reverse_solidus" ]
    },
    "codeblock": {
      "$type": "compound",
      "start": [ "char_open_bracket" ],
      "stop": [ "char_close_bracket" ]
    }
  }
}