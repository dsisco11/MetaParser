{
  "$schema": "https://raw.githubusercontent.com/dsisco11/MetaParser/master/Schemas/schema-01.json",
  "namespace": "UnitTestParser",
  "definitions": {
    "keyword_var": {
      "$type": "data",
      "start": "var"
    },
    "keyword_function": {
      "$type": "data",
      "start": "function"
    },
    "keyword_byte": {
      "$type": "data",
      "start": "byte"
    },
    "keyword_short": {
      "$type": "data",
      "start": "short"
    },
    "keyword_int": {
      "$type": "data",
      "start": "int"
    },
    "keyword_float": {
      "$type": "data",
      "start": "float"
    },
    "char_open_bracket": {
      "$type": "data",
      "start": "{"
    },
    "char_close_bracket": {
      "$type": "data",
      "start": "}"
    },
    "char_open_sqbracket": {
      "$type": "data",
      "start": "["
    },
    "char_close_sqbracket": {
      "$type": "data",
      "start": "]"
    },
    "char_open_parenthesis": {
      "$type": "data",
      "start": "("
    },
    "char_close_parenthesis": {
      "$type": "data",
      "start": ")"
    },
    "char_asterisk": {
      "$type": "data",
      "start": "*"
    },
    "char_solidus": {
      "$type": "data",
      "start": "/"
    },
    "char_reverse_solidus": {
      "$type": "data",
      "start": "\\"
    },
    "whitespace": {
      "$type": "data",
      "consume": [ " ", "\t", "\f" ]
    },
    "digits": {
      "$type": "data",
      "consume": { "range": [ "0", "9" ] }
    },
    "letters": {
      "$type": "data",
      "consume": [
        { "range": [ "a", "z" ] },
        { "range": [ "A", "Z" ] }
      ]
    },
    "newline": {
      "$type": "data",
      "consume": [ "\r", "\n" ]
    },
    "identifier": [
      {
        "$type": "data",
        "start": [
          {
            "or": [
              { "range": [ "a", "z" ] },
              { "range": [ "A", "Z" ] }
            ]
          }
        ],
        "consume": [
          {
            "or": [
              { "range": [ "a", "z" ] },
              { "range": [ "A", "Z" ] }
            ]
          },
          { "range": [ "0", "9" ] },
          "-",
          "_"
        ]
      },
      {
        "$type": "tokens",
        "start": [ "identifier" ]
      }
    ],
    "typename": [
      {
        "$type": "tokens",
        "start": "keyword_var"
      },
      {
        "$type": "tokens",
        "start": "keyword_byte"
      },
      {
        "$type": "tokens",
        "start": "keyword_short"
      },
      {
        "$type": "tokens",
        "start": "keyword_int"
      },
      {
        "$type": "tokens",
        "start": "keyword_float"
      }
    ],
    "comment": {
      "$type": "tokens",
      "start": [ "char_solidus", "char_asterisk" ],
      "stop": [ "char_asterisk", "char_solidus" ],
      "escape": [ "char_reverse_solidus" ]
    },
    "codeblock": {
      "$type": "tokens",
      "start": [ "char_open_bracket" ],
      "stop": [ "char_close_bracket" ]
    }
  }
}